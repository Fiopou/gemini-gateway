# Пул ключей Google AI Studio (по одному на проект; через запятую)
GEMINI_KEYS=AIza...,AIza...

# HTTP(S)-прокси для Google (иначе гео-блок "User location is not supported").
# Пустое значение = напрямую. v2rayNG/NekoBox: обычно http://127.0.0.1:10809
GEMINI_PROXY=http://127.0.0.1:10809

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8788

